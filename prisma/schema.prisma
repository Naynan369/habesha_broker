// Habesha Brokers data model
// The PostgreSQL database is configured through DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  firstName     String
  lastName      String
  email         String          @unique
  password      String
  bio           String?
  profile_url   String?
  role          Role            @default(USER)
  verfied       Boolean         @default(false)
  ContactInfo   ContactInfo[]
  AddedItem     Item[]          @relation("Addes")
  ApprovedItem  Item[]          @relation("Approves")
  SavedItems    SavedItems[]
  RecentActions RecentActions[]
  Verification  Verification[]
  PasswordReset PasswordReset[]
}

model ContactInfo {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactType ContactType
  value       String
}

model Verification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  requestTime DateTime @default(now())
}

model PasswordReset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        String   @unique
  requestTime DateTime @default(now())
}

model Item {
  id            String         @id @default(cuid())
  title         String
  featured      Boolean        @default(false)
  description   String?
  price         Float
  priceType     PriceType
  images        String[]       @default([])
  createdAt     DateTime       @default(now())
  itemType      ItemType
  status        ItemStatus     @default(PENDING)
  userId        String
  user          User           @relation("Addes", fields: [userId], references: [id], onDelete: Cascade)
  approvedId    String?
  approvedUser  User?          @relation("Approves", fields: [approvedId], references: [id])
  House         House?
  Car           Car?
  BusinessSpace BusinessSpace?
  Service       Service?
  SavedItems    SavedItems[]
  RecentActions RecentActions[]

  @@index([status, createdAt])
  @@index([itemType, status])
}

model House {
  id     String @id @default(cuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  area   Float?
  room   Int?
  type   HouseType?
  region String?
  city   String?
}

model Car {
  id     String @id @default(cuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  model        String
  status       CarType
  manufacturer String
  year         Int?
  transmition  String
  color        String?
  cylinder     Float?
  fuel         Float?
}

model BusinessSpace {
  id             String               @id @default(cuid())
  itemId         String               @unique
  item           Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  spaceType      CommercialSpaceType
  type           HouseType
  priceFrequency PriceFrequency?
  area           Float
  region         String
  city           String
  subcity        String?
  woreda         String?
  neighborhood   String?
  landmark       String?
  electricity    Boolean              @default(false)
  water          Boolean              @default(false)
  roadAccess     Boolean              @default(false)
  parking        Boolean              @default(false)
}

model Service {
  id          String          @id @default(cuid())
  itemId      String          @unique
  item        Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category    ServiceCategory
  region      String
  city        String
  serviceArea String?

  @@index([category, region, city])
}

model SavedItems {
  id      String   @id @default(cuid())
  savedAt DateTime @default(now())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId  String
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model RecentActions {
  id         String     @id @default(cuid())
  actionType ActionType
  actionTime DateTime   @default(now())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([actionTime])
}

enum ItemType {
  HOUSE
  CAR
  BUSINESS_SPACE
  SERVICE
}

enum ServiceCategory {
  BROKER_SUPPORT
  PROPERTY_PHOTOGRAPHY
  MOVING
  CLEANING
  REPAIRS
  PROPERTY_MANAGEMENT
}

enum Role {
  ADMIN
  USER
}

enum ItemStatus {
  PENDING
  APPROVED
  DECLINED
  SOLD
}

enum ContactType {
  TELEGRAM
  FACEBOOK
  INSTAGRAM
  PHONE_NUMBER
  ADDRESS
  EMAIL
}

enum HouseType {
  RENT
  FORSALE
}

enum CommercialSpaceType {
  SHOP
  OFFICE
  WAREHOUSE
  MARKET_STALL
  WORKSHOP
  LAND
}

enum PriceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CarType {
  USED
  NEW
  NEW_ETH
}

enum ActionType {
  ADDED
  SAVED
  APPROVED
}

enum PriceType {
  FIXED
  NEGOTIABLE
}
